# Copier ce fichier vers backend/.env et remplir les valeurs. Ne jamais committer backend/.env.

# --- PostgreSQL ---
DB_NAME=pif_trading_db
DB_USERNAME=postgres
DB_PASSWORD=
DB_URL=jdbc:postgresql://localhost:5432/pif_trading_db

# --- JWT (32 caractères minimum) ---
# Générer par exemple avec : openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# --- Compte administrateur créé au premier démarrage (laisser vide pour ne pas en créer) ---
# Mot de passe : 12 caractères minimum
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# --- Services externes ---
ALPHA_VANTAGE_API_KEY=
AI_SERVICE_URL=http://localhost:8000

# --- pgAdmin (optionnel, profil "tools") ---
PGADMIN_EMAIL=
PGADMIN_PASSWORD=
